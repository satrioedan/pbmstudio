# Tambahkan ke .env aplikasi lama. Jangan timpa API key atau konfigurasi lain.
MCP_ENABLED=true
MCP_PUBLIC_URL=https://lagu.bangalimin.com
MCP_OWNER_ID=ISI_DENGAN_GJM_CLIENT_BROWSER_ANDA
MCP_CLIENT_ID=gejemuzik-chatgpt
MCP_CLIENT_SECRET=GANTI_DENGAN_RANDOM_SECRET_PERTAMA
MCP_LOGIN_SECRET=GANTI_DENGAN_RANDOM_SECRET_KEDUA
MCP_REDIRECT_URIS=ISI_DENGAN_CALLBACK_HTTPS_PERSIS_DARI_CHATGPT
# Di Vercel, token login dan jurnal otomatis tersimpan di Neon.
# Default jurnal lokal: .mcp-journal.json di root aplikasi. Pilihan lokasi absolut:
# MCP_JOURNAL_PATH=/path/private/gejemuzik-mcp-journal.json
# Jangan aktifkan opsi berikut di produksi:
# MCP_ALLOW_LOCAL_HTTP=false
